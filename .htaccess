# =====================================================================================
# Lumina Africa Foundation - root .htaccess  (WEB ROOT = PROJECT ROOT, no public/ folder)
#   * real files below assets/ and uploads/ (only) are served directly
#   * everything else is rewritten to index.php (front controller), even when a file of that name exists
#   * app code (app/, bin/, database/, ...) and secrets (.env, *.sql, ...) are never served
# Works at http://localhost/lumina/, at a domain root, or in any sub-folder (no RewriteBase).
# Needs: AllowOverride All (XAMPP default) and mod_rewrite.
# =====================================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php
ServerSignature Off
AddDefaultCharset UTF-8

# ---- 1. Block secrets, source and tooling files wherever they are ----
<FilesMatch "(^\.env|\.(env|sql|md|py|log|ini|bak|sh|dist|lock|scss|map|yml|yaml|eml|swp|zip|gz|tgz|tar|7z|rar|old|orig|save|dump|key|pem|crt|pfx|p12|sqlite3?|db)$|^(composer|package)(-lock)?\.json$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Only the front controller may be executed from the web root; other scripts are refused.
<FilesMatch "\.(php[0-9]?|phtml|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<FilesMatch "^index\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# ---- 2. Headers ----
# Security headers + CSP for every dynamic page are sent by the application itself (App\Core\Response). Static files get
# X-Content-Type-Options from assets/.htaccess and uploads/.htaccess. (Not repeated here to avoid duplicate headers.)
<IfModule mod_headers.c>
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff2 .woff2
    AddType text/javascript .js
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>

# ---- 3. Routing ----
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internal folders: forbidden even if their own .htaccess were missing.
    RewriteRule ^(app|bin|database|docs|scss|storage|tools|vendor|tests|node_modules|\.git)(/|$) - [F,NC,L]

    # Dotfiles / dot-folders (but allow /.well-known/).
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Sensitive file types anywhere.
    RewriteRule \.(env|sql|md|py|log|ini|bak|sh|lock|scss|eml|zip|gz|tgz|tar|7z|rar|old|orig|save|dump|key|pem|crt|pfx|p12|sqlite3?|db|swp|inc|dist)$ - [F,NC,L]

    # ALLOW-LIST: only real files below assets/ and uploads/ are served directly (their own .htaccess then restricts the
    # file types). A backup, dump, log or key file dropped anywhere else in the project root is never handed out: it is
    # answered by the application (404), whatever its name or extension.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(assets|uploads)/ - [L]

    # Google Search Console ownership file (googleXXXXXXXX.html in the site root): served as the real file.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^google[0-9a-f]{8,}\.html$ - [L]

    # Everything else is the application (clean URLs). The environment flag tells a LiteSpeed server-level page cache (some shared hosts switch
    # one on for the whole account) never to store these dynamic pages: an admin change (a published newsletter, a new partner) must be visible
    # at once. Apache ignores it. (The application also sends "private, max-age=0, must-revalidate" itself.)
    RewriteRule ^ index.php [L,E=Cache-Control:no-cache]
</IfModule>

# Without mod_rewrite the app cannot route; refuse to serve rather than expose source.
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</IfModule>

# ---- 4. OPTIONAL: let ONLY Cloudflare (and this server itself) reach the origin  -- OFF BY DEFAULT ------------------------------
# Purpose: once Cloudflare is live, nobody can bypass its filters by calling the hosting address directly.
#
#   !!! WARNING: switching this on BEFORE Cloudflare is live and working takes the WHOLE SITE OFFLINE (everybody gets "403 Forbidden").
#   !!! Do it only when ALL of these are true:
#       1. The name servers have been switched and Cloudflare shows the site as "Active" for at least a few days;
#       2. Admin > Security > Cloudflare says "This request arrived through Cloudflare" AND shows "connection from" an address that
#          is a Cloudflare address (if the connection comes from some other address, Hostinger's own front server sits between
#          Cloudflare and the site and THIS BLOCK MUST STAY OFF: it would block Hostinger's server);
#       3. You can reach the file manager to undo it (put the "#" signs back) if the site goes down.
#
# To switch it on, remove the "# " at the start of the lines between "BEGIN" and "END" below. The list is Cloudflare's published ranges
# (copied 2026-11-26 from https://www.cloudflare.com/ips-v4 and /ips-v6; check those pages again every year and update this list AND
# app/core/Cloudflare.php). Your own server's loopback address is allowed so the site can call itself (cache check, cron jobs).
# Authenticated Origin Pulls (Cloudflare proves itself with a certificate) is the stronger version, but it needs an SSL setting
# that Hostinger shared hosting does not offer; the address list below is the practical choice. See docs/CLOUDFLARE.md section 12.
#
# BEGIN origin lock (Cloudflare only)
# <IfModule mod_authz_core.c>
#     <RequireAny>
#         Require ip 127.0.0.1 ::1
#         Require ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20
#         Require ip 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
#         Require ip 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
#     </RequireAny>
# </IfModule>
# END origin lock
