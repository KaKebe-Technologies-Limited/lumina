# Copy to .env and adjust. NEVER commit .env.
APP_ENV=local
# 1 = show errors (development only!). MUST be 0 in production
APP_DEBUG=1
# Public address, e.g. https://www.luminaafricafoundation.com (no trailing slash). REQUIRED when APP_ENV is not "local"
# (links in e-mails, canonical URLs and the sitemap are built from it, never from the Host header).
# Empty is only accepted for local development (auto-detect from the request).
APP_URL=
# Extra host names the site may answer to besides the APP_URL host (comma list). Other Host headers get HTTP 400 outside local.
ALLOWED_HOSTS=
# Random 32+ char secret (signs honeypot timestamps). Empty = auto-generated into storage/app.key
APP_KEY=
APP_TIMEZONE=Africa/Kampala
# Hosting without a shell? After importing database/schema.sql, set a long random value here (16+ characters), open /install to create
# the first administrator, then REMOVE this line. /install answers 404 when this is empty or when any user already exists.
INSTALL_TOKEN=
# 1 = the public site shows the maintenance page (logged-in admins and /admin keep working)
APP_MAINTENANCE=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lumina
DB_USER=root
DB_PASS=

# Mail: "file" writes .eml files to storage/mail (default when APP_ENV=local); "mail" uses PHP mail(); "smtp" talks to a mail server (needed to e-mail the newsletter)
MAIL_DRIVER=
MAIL_FROM=no-reply@luminaafricafoundation.com
MAIL_FROM_NAME=Lumina Africa Foundation
# SMTP (MAIL_DRIVER=smtp only). These credentials live ONLY here: never in the database, the admin or the logs. Quote a password that contains "#".
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465              # 465 with MAIL_ENCRYPTION=ssl, 587 with MAIL_ENCRYPTION=tls (STARTTLS)
# MAIL_ENCRYPTION=ssl        # ssl | tls | none (none is only accepted for a login on 127.0.0.1 / localhost)
# MAIL_USERNAME=newsletter@your-domain
# MAIL_PASSWORD="your-mailbox-password"
# MAIL_TIMEOUT=20            # seconds to wait for the server
# MAIL_CAFILE=               # optional path to a CA bundle if the server has none. Certificate checks are always ON.

# Bono AI (the support assistant, docs/BONO.md). Optional: with a key Claude phrases the answers from the website passages; without it Bono answers from the passages itself.
# ANTHROPIC_API_KEY=sk-ant-...
# BONO_MODEL=claude-opus-5-5        # claude-haiku-5-5 is the cheapest choice for a busy site

# "Continue with Google" for LAF Academy learners (docs/ACADEMY.md). Google Cloud console > APIs & Services > Credentials > Create credentials > OAuth client ID >
# Web application; authorised redirect URI = https://YOUR-SITE/academy/google/callback . Leave these out and the Google button stays hidden.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# WhatsApp confirmation codes for LAF Academy learners (WhatsApp Business Cloud API by Meta; docs/ACADEMY.md). Leave these out and the WhatsApp option stays hidden.
# WHATSAPP_TOKEN=                  permanent access token of a system user
# WHATSAPP_PHONE_ID=               the "Phone number ID" of your WhatsApp Business number
# WHATSAPP_TEMPLATE=verification_code   an approved template of the category Authentication
# WHATSAPP_LANGUAGE=en             the language the template was approved in (en, en_US ...)
# WHATSAPP_COUNTRY_CODE=256        added to local numbers that start with 0
# WHATSAPP_COPY_BUTTON=1           1 = the template has the standard "Copy code" button (authentication templates do)

# Pesapal: the LAF Academy certificate fee is paid through Pesapal (mobile money + cards; docs/PESAPAL.md). Get the keys from the Pesapal merchant dashboard (Settings > API keys).
# The same keys work on every site of the same merchant account. Without them learners cannot pay and certificates that need a fee stay locked. NEVER commit real keys.
# PESAPAL_ENV=live                  live | sandbox (sandbox keys are different values)
# PESAPAL_CONSUMER_KEY=
# PESAPAL_CONSUMER_SECRET=
# PESAPAL_IPN_ID=                   leave empty: the site registers its OWN notification address (https://YOUR-SITE/academy/pay/ipn) with Pesapal on the first payment and remembers the id
# PESAPAL_PUBLIC_URL=https://xxxx.ngrok-free.app   only while developing on localhost: an https tunnel Pesapal can reach (return + notification addresses). Never in production.
# PESAPAL_DEV_BASE_URL=http://127.0.0.1:8098     DEVELOPMENT ONLY (honoured only when APP_ENV=local): send every Pesapal call to the local mock: php -S 127.0.0.1:8098 bin/dev/mock-pesapal.php

# Proxy IPs or CIDR ranges (comma list, e.g. 10.0.0.0/8,127.0.0.1) whose X-Forwarded-For / X-Forwarded-Proto headers are trusted.
# MANDATORY behind a reverse proxy / CDN (otherwise every visitor looks like one IP and shares the form and login rate limits);
# leave empty when Apache receives the visitors directly. The client IP is the first non-proxy hop counted from the right.
TRUSTED_PROXIES=

# Social media auto-share (Admin > Social media > Auto-share channels; docs/SOCIAL.md). Each platform needs YOUR OWN developer app / bot. The keys can be typed in the admin
# (stored ENCRYPTED with APP_KEY: keep APP_KEY set and never change it) OR set here; a value here wins and the admin shows "Set in the .env file". Leave them out if you use the admin.
# SOCIAL_FB_PAGE_TOKEN=          # Facebook PAGE access token (long-lived)
# SOCIAL_IG_TOKEN=               # optional, Instagram only; empty = the Facebook Page token
# SOCIAL_X_API_KEY=
# SOCIAL_X_API_SECRET=
# SOCIAL_X_ACCESS_TOKEN=
# SOCIAL_X_ACCESS_SECRET=
# SOCIAL_X_BEARER_TOKEN=         # only for the "Bearer user token" mode (expires after about two hours)
# SOCIAL_LI_ACCESS_TOKEN=        # LinkedIn organisation token (about 60 days)
# SOCIAL_TG_BOT_TOKEN=           # Telegram bot token from @BotFather
# SOCIAL_WEBHOOK_URL=            # the webhook address (Zapier / Make / IFTTT hook addresses are credentials: treat like a password)
# SOCIAL_WEBHOOK_SECRET=         # optional signing secret of the webhook (X-Lumina-Signature)
# SOCIAL_CAFILE=                 # optional CA bundle for the HTTPS calls if the server has none (certificate checks are always ON)
# DEVELOPMENT ONLY (honoured only when APP_ENV=local): send every social API call to the local mock: php -S 127.0.0.1:8123 bin/dev/mock-social.php
# SOCIAL_DEV_BASE_URL=http://127.0.0.1:8123
