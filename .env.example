# Copy to .env and adjust. NEVER commit .env.
APP_ENV=local
# 1 = show errors (development only!). MUST be 0 in production
APP_DEBUG=1
# Public address, e.g. https://www.luminaafricafoundation.com (no trailing slash). REQUIRED when APP_ENV is not "local"
# (links in e-mails, canonical URLs and the sitemap are built from it, never from the Host header).
# Empty is only accepted for local development (auto-detect from the request).
APP_URL=
# Extra host names the site may answer to besides the APP_URL host (comma list). Other Host headers get HTTP 400 outside local.
ALLOWED_HOSTS=
# Random 32+ char secret (signs honeypot timestamps). Empty = auto-generated into storage/app.key
APP_KEY=
APP_TIMEZONE=Africa/Kampala
# Hosting without a shell? After importing database/schema.sql, set a long random value here (16+ characters), open /install to create
# the first administrator, then REMOVE this line. /install answers 404 when this is empty or when any user already exists.
INSTALL_TOKEN=
# 1 = the public site shows the maintenance page (logged-in admins and /admin keep working)
APP_MAINTENANCE=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lumina
DB_USER=root
DB_PASS=

# Mail: "file" writes .eml files to storage/mail (default when APP_ENV=local); "mail" uses PHP mail()
MAIL_DRIVER=
MAIL_FROM=no-reply@luminaafricafoundation.com
MAIL_FROM_NAME=Lumina Africa Foundation

# Proxy IPs or CIDR ranges (comma list, e.g. 10.0.0.0/8,127.0.0.1) whose X-Forwarded-For / X-Forwarded-Proto headers are trusted.
# MANDATORY behind a reverse proxy / CDN (otherwise every visitor looks like one IP and shares the form and login rate limits);
# leave empty when Apache receives the visitors directly. The client IP is the first non-proxy hop counted from the right.
TRUSTED_PROXIES=
